{
  "name": "@axme/code",
  "version": "0.5.0",
  "description": "Persistent memory, decisions, and safety guardrails for Claude Code",
  "type": "module",
  "main": "./dist/server.js",
  "bin": {
    "axme-code": "./dist/axme-code.js"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "dev": "tsx src/cli.ts",
