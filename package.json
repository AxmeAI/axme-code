  },
  "optionalDependencies": {
    "@cursor/sdk": "1.0.12"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AxmeAI/axme-code.git"
  },
  "license": "MIT",
