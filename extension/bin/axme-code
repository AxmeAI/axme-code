function readHandoff(projectPath) {
  const content = readSafe((0, import_node_path10.join)(plansRoot(projectPath), "handoff.md"));
  if (!content || content.trim().length < 10) return null;
  const get = (heading) => {
    const regex = new RegExp(`## ${heading}\\n([\\s\\S]*?)(?=\\n## |$)`);
