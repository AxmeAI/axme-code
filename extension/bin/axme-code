async function checkMcpServerBoot(binaryPath) {
  return new Promise((resolve9) => {
    const child = (0, import_node_child_process5.spawn)(binaryPath, ["serve"], { stdio: ["pipe", "pipe", "pipe"] });
    let stdout = "";
    let resolved = false;
    const finish = (ok, detail) => {
      if (resolved) return;
      resolved = true;
      try {
        child.kill();
      } catch {
      }
      record2("MCP server boot", ok, detail);
      resolve9();
    };
    const timer = setTimeout(() => finish(false, "no response after 5s"), 5e3);
    child.stdout.on("data", (chunk) => {
      stdout += chunk.toString();
      if (stdout.includes('"protocolVersion"')) {
        clearTimeout(timer);
        finish(true, "stdio handshake ok");
      }
    });
    child.on("error", (err) => {
      clearTimeout(timer);
      finish(false, err.message);
    });
    child.on("exit", (code) => {
      if (resolved) return;
      clearTimeout(timer);
      finish(false, `exited prematurely (code ${code})`);
    });
    child.stdin.write(
      JSON.stringify({
        jsonrpc: "2.0",
        id: 1,
        method: "initialize",
        params: { protocolVersion: "2024-11-05", capabilities: {}, clientInfo: { name: "selftest", version: "0.0.2" } }
      }) + "\n"
    );
  });
}
