    const globs = packagesMatch[1].split("\n").map((line) => line.replace(/^\s*-\s*['"]?/, "").replace(/['"]?\s*$/, "").trim()).filter(Boolean).filter((g9) => !g9.startsWith("!"));
    const projects = resolveGlobs(root, globs);
    if (projects.length < 2) return null;
    return { type: "pnpm", root, projects, manifestPath: filePath };
  } catch {
    return null;
  }
}
