      writeClaudeSessionMapping(defaultProjectPath, m6.claudeSessionId, m6.axmeSessionId);
      process.stderr.write(
        `AXME: adopted stale mapping ${m6.claudeSessionId.slice(0, 8)} (old ppid=${m6.ownerPpid}, new ppid=${OWN_PPID})
