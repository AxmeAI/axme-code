function readClaudeSessionMapping(projectPath, claudeSessionId) {
  const raw = readSafe(activeMappingPath(projectPath, claudeSessionId)).trim();
  if (!raw) return null;
  if (raw.startsWith("{")) {
    try {
      const parsed = JSON.parse(raw);
      return parsed.axmeSessionId || null;
    } catch {
      return null;
    }
  }
  return raw;
}
function readClaudeSessionMappingFull(projectPath, claudeSessionId) {
  const raw = readSafe(activeMappingPath(projectPath, claudeSessionId)).trim();
  if (!raw) return null;
  if (raw.startsWith("{")) {
    try {
      return JSON.parse(raw);
    } catch {
      return null;
    }
  }
  return { axmeSessionId: raw };
}
