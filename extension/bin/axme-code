    void auditOrphansInBackground();
  }, 3e3);
}
async function auditOrphansInBackground() {
  try {
    const ownedAxmeIds = new Set(
      listClaudeSessionMappings(defaultProjectPath).filter((m6) => m6.ownerPpid === OWN_PPID).map((m6) => m6.axmeSessionId)
    );
    const orphans = findOrphanSessions(defaultProjectPath);
    for (const orphan of orphans) {
      if (ownedAxmeIds.has(orphan.id)) continue;
      try {
        spawnDetachedAuditWorker(defaultProjectPath, orphan.id);
        logEvent(defaultProjectPath, "session_orphan_audit_queued", orphan.id, {
          filesChanged: orphan.filesChanged.length,
          closedByPpid: OWN_PPID,
          workerSpawned: true
        });
      } catch (err) {
        process.stderr.write(`AXME orphan audit: failed to spawn worker for ${orphan.id}: ${err}
`);
      }
    }
  } catch (err) {
    process.stderr.write(`AXME orphan scan failed: ${err}
`);
  }
}
