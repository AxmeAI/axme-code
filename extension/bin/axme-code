function resolveGlobs(root, globs) {
  const projects = [];
  for (const glob of globs) {
    if (glob.endsWith("/*") || glob.endsWith("/**")) {
      const dir = glob.replace(/\/\*\*?$/, "");
      const fullDir = (0, import_node_path14.join)(root, dir);
      if (!(0, import_node_fs13.existsSync)(fullDir)) continue;
      for (const entry of safeReaddir(fullDir)) {
        const entryPath = (0, import_node_path14.join)(fullDir, entry);
        if (!isDir2(entryPath)) continue;
        if ((0, import_node_fs13.existsSync)((0, import_node_path14.join)(entryPath, "package.json"))) {
          const path = (0, import_node_path14.join)(dir, entry);
          if (!projects.some((p) => p.path === path)) {
            projects.push({ path, name: entry });
          }
        }
      }
    } else {
      const fullPath = (0, import_node_path14.join)(root, glob);
      if ((0, import_node_fs13.existsSync)(fullPath) && isDir2(fullPath)) {
        if (!projects.some((p) => p.path === glob)) {
          projects.push({ path: glob, name: (0, import_node_path14.basename)(glob) });
        }
      }
    }
  }
  return projects;
}
