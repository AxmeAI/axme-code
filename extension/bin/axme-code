function worklogStats(projectPath) {
  const events = readWorklog(projectPath);
  let totalSessions = 0;
  let totalAudits = 0;
  let totalCostUsd = 0;
  const safetyBlocks = [];
  const recentErrors = [];
  for (const e4 of events) {
    switch (e4.type) {
      case "session_start":
        totalSessions++;
        break;
      case "audit_complete":
        totalAudits++;
        totalCostUsd += e4.data.costUsd ?? 0;
        break;
      case "safety_block":
        safetyBlocks.push({
          tool: e4.data.tool,
          target: e4.data.target,
          reason: e4.data.reason,
          timestamp: e4.timestamp
        });
        break;
      case "error":
        recentErrors.push({
          error: e4.data.error,
          timestamp: e4.timestamp
        });
        break;
    }
  }
  return { totalSessions, totalAudits, totalCostUsd, safetyBlocks, recentErrors: recentErrors.slice(0, 10) };
}
