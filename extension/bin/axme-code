function parseIdeFlag(args2) {
  for (let i9 = 0; i9 < args2.length; i9++) {
    const a6 = args2[i9];
    if (a6 === "--ide" && i9 + 1 < args2.length) {
      const v6 = args2[i9 + 1];
      if (IDE_VALUES.includes(v6)) return v6;
    } else if (a6.startsWith("--ide=")) {
      const v6 = a6.slice("--ide=".length);
      if (IDE_VALUES.includes(v6)) return v6;
    }
  }
  return void 0;
}
