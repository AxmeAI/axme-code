function searchMemories(projectPath, keywords) {
  if (keywords.length === 0) return [];
  const all = listMemories(projectPath);
  const normalized = keywords.map((k10) => k10.toLowerCase());
  const scored = [];
  for (const m6 of all) {
    let score = 0;
    const searchable = [m6.title, m6.description, m6.body, ...m6.keywords].join(" ").toLowerCase();
    for (const kw of normalized) {
      if (searchable.includes(kw)) score++;
    }
    if (score > 0) scored.push({ memory: m6, score });
  }
  scored.sort((a6, b10) => b10.score - a6.score);
  return scored.map((s6) => s6.memory);
}
