function getOwnedSessionIdForLogging() {
  const all = listClaudeSessionMappings(defaultProjectPath);
  const owned = all.filter((m6) => m6.ownerPpid === OWN_PPID);
  if (owned.length > 0) return owned[0].axmeSessionId;
