function semverGreater(a6, b10) {
  const pa = a6.replace(/^v/, "").split(".").map(Number);
  const pb = b10.replace(/^v/, "").split(".").map(Number);
  for (let i9 = 0; i9 < 3; i9++) {
    if ((pa[i9] ?? 0) > (pb[i9] ?? 0)) return true;
    if ((pa[i9] ?? 0) < (pb[i9] ?? 0)) return false;
  }
  return false;
}
