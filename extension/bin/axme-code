      string4,
      singleLineOnly,
      state.indent,
      lineWidth,
      testAmbiguity,
      state.quotingType,
      state.forceQuotes && !iskey,
      inblock
    )) {
      case STYLE_PLAIN:
        return string4;
      case STYLE_SINGLE:
        return "'" + string4.replace(/'/g, "''") + "'";
      case STYLE_LITERAL:
        return "|" + blockHeader(string4, state.indent) + dropEndingNewline(indentString(string4, indent));
      case STYLE_FOLDED:
