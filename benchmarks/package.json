{
  "name": "axme-code-benchmarks",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Competitive benchmarks for AXME Code — LongMemEval, ToolEmu, feature matrix",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "tsx --test lib/*.test.ts",
    "bench:toolemu": "tsx toolemu/run.ts",
