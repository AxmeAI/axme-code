{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "#product/*": ["../src/*"]
    }
  },
  "include": ["lib/**/*.ts", "longmemeval/**/*.ts", "toolemu/**/*.ts"]
}
