graph LR
    subgraph CC["Claude Code"]
        A["Agent"]
    end

    subgraph AX["AXME Code"]
        MCP["MCP Server"]
        H["Hooks"]
        AU["Auditor"]
    end

    subgraph KB[".axme-code/ Knowledge Base"]
        O["Oracle\nstack, structure,\npatterns"]
        D["Decisions\nrules, policies"]
        M["Memory\nfeedback, patterns"]
        S["Safety\ngit, bash, fs\nguardrails"]
        HO["Handoff\nsession state"]
